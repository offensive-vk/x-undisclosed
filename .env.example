# System
SYSVER=1
CI=true

# Firebase Configuration (required for LikeButton feature)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# Spotify Now Playing Widget
# URL to your Cloudflare Worker / Vercel Edge Function that proxies Spotify's API
# The endpoint should return: { isPlaying, title, artist, albumImageUrl, songUrl }
PUBLIC_SPOTIFY_NOW_PLAYING_URL=
