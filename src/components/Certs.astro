---
type CertificateType = { title: string; url?: string };
const certs: CertificateType[] = [
  {
    title: 'Cisco Operating Systems Support',
    url: 'https://www.credly.com/badges/7ec26324-f4c0-4ca4-a2da-a0e0333f5bdc'
  },
  {
    title: 'Cisco Network Support and Security',
    url: 'https://www.credly.com/badges/7b7d90bf-3e5b-4aa6-91e6-62c64cf9d48f'
  },
  {
    title: 'Cisco Certified Ethical Hacker',
    url: 'https://www.credly.com/badges/76091e6a-a773-4d79-921a-8bf353e529f1'
  },
  {
    title: 'Cisco Linux Essentials',
    url: 'https://www.credly.com/badges/eed5dec9-3749-4480-9030-53d8b5f7358f'
  }
];
---

<section
  id="certifications"
  class="py-16 px-4 border-t border-[#ffffff10] text-[var(--white)] bg-[var(--background)]"
>
  <div class="max-w-5xl mx-auto text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-[var(--sec)] shiny-sec mb-8">
      🎓 My Certifications
    </h2>

    <ul class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        certs.map((cert) => (
          <li class="bg-[#1e1e1e] p-6 rounded-2xl shadow-lg hover:shadow-[0_8px_30px_-5px_var(--pink)] hover:-translate-y-1 transition-all duration-300">
            <h3 class="text-xl sm:text-2xl font-semibold mb-2 text-[var(--white)]">{cert.title}</h3>
            {
              cert.url && (
                <a
                  href={cert.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm sm:text-base text-[var(--white-icon)] underline hover:text-[var(--sec)] transition-colors inline-flex items-center gap-2"
                >
                  View Credential
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                    viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M13 7h4a2 2 0 012 2v8a2 2 0 01-2 2h-8a2 2 0 01-2-2v-4m10-10L10 14M7 10h.01" />
                  </svg>
                </a>
              )
            }
          </li>
        ))
      }
    </ul>
  </div>
</section>
