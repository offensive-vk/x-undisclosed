---

<footer
  id="footer-section"
  class="relative w-full py-12 px-6 sm:px-8 border border-[#ffffff10] rounded-3xl overflow-hidden my-6 transition-all duration-500 ease-in-out"
>
  <!-- Background Ripple / Expansion Container -->
  <div
    id="footer-ripple-container"
    class="absolute inset-0 pointer-events-none overflow-hidden rounded-3xl z-0"
  >
  </div>

  <div class="relative z-10 max-w-5xl mx-auto">
    <!-- Tech Stack Row -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-10 md:gap-14 py-4">
      {
        techStack.map((tech) => (
          <div
            data-tech={tech.id}
            data-color={tech.color}
            class="flex items-center space-x-3 group cursor-crosshair w-fit select-none px-3 py-1.5 rounded-xl hover:bg-[#ffffff08] transition-all duration-300"
          >
            <span class="text-[var(--white-icon)] text-sm transition-colors duration-300">
              {tech.desc}
            </span>
            <img
              src={tech.icon}
              alt={tech.alt}
              loading="lazy"
              class="tech-icon h-5 w-5 object-contain filter invert brightness-0 opacity-80 transition duration-500 ease-in-out group-hover:invert-0 group-hover:brightness-100 group-hover:opacity-100 group-hover:drop-shadow-[0_2px_8px_rgba(0,0,0,0.5)]"
            />
            <span class="text-[var(--white-icon)] text-lg transition-colors duration-300 font-medium">
              {tech.name}
            </span>
          </div>
        ))
      }
    </div>

    <!-- Copyright & Social Links Row -->
    <div class="mt-8 pt-6 border-t border-[#ffffff10] flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-[var(--white-icon)]">
        Copyright © 2026 <a href="https://github.com/offensive-vk" target="_blank" rel="noopener noreferrer" class="text-[var(--white)] hover:underline font-medium">
          Me</a>. All rights reserved.
      </p>

      <div class="flex items-center space-x-3 sm:space-x-4">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[var(--white-icon)] hover:text-[var(--white)] hover:scale-110 transition-all duration-300 ease-in-out p-2 rounded-xl hover:bg-[#ffffff12] flex items-center justify-center"
              aria-label={link.label}
              title={link.label}
            >
              <div set:html={link.icon} class="flex items-center justify-center" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  [data-tech] {
    cursor: crosshair;
  }

  [data-tech] * {
    cursor: crosshair;
  }
</style>

<script>
  function setupFooterRipple() {
    const footer = document.getElementById("footer-section");
    const container = document.getElementById("footer-ripple-container");
    const techItems = document.querySelectorAll<HTMLElement>("[data-tech]");

    if (!footer || !container) return;

    let currentRipple: HTMLElement | null = null;
    let activeTech: string | null = null;

    techItems.forEach((item) => {
      const techId = item.getAttribute("data-tech");
      const color = item.getAttribute("data-color");
      const iconImg = item.querySelector("img");

      item.addEventListener("mouseenter", () => {
        if (!color || activeTech === techId) return;
        activeTech = techId;

        const footerRect = footer.getBoundingClientRect();
        const targetEl = iconImg || item;
        const iconRect = targetEl.getBoundingClientRect();

        // Exact center coordinates of the icon relative to the footer container
        const originX = Math.round(
          iconRect.left + iconRect.width / 2 - footerRect.left
        );
        const originY = Math.round(
          iconRect.top + iconRect.height / 2 - footerRect.top
        );

        // Maximum radius to reach the furthest corner of the footer
        const maxDist = Math.ceil(
          Math.hypot(
            Math.max(originX, footerRect.width - originX),
            Math.max(originY, footerRect.height - originY)
          ) * 1.05
        );

        // Create ripple element
        const ripple = document.createElement("div");
        ripple.className = "absolute inset-0 rounded-3xl pointer-events-none";
        ripple.style.backgroundColor = color;
        ripple.style.zIndex = "1";
        ripple.style.opacity = "1";
        ripple.style.willChange = "clip-path, opacity";
        
        // Initial state: circle with 0 radius centered at icon
        ripple.style.clipPath = `circle(0px at ${originX}px ${originY}px)`;

        container.appendChild(ripple);

        // Force reflow so browser commits the 0px state before animating
        void ripple.offsetWidth;

        // Set transition duration to 1.3s for a slow, fluid bloom
        ripple.style.transition =
          "clip-path 1.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.8s ease-in-out";

        // Trigger expansion on next frame
        requestAnimationFrame(() => {
          ripple.style.clipPath = `circle(${maxDist}px at ${originX}px ${originY}px)`;
        });

        const prevRipple = currentRipple;
        currentRipple = ripple;

        if (prevRipple) {
          setTimeout(() => {
            if (
              prevRipple &&
              prevRipple !== currentRipple &&
              prevRipple.parentNode
            ) {
              prevRipple.remove();
            }
          }, 1400);
        }
      });

      item.addEventListener("mouseleave", (e: MouseEvent) => {
        const related = e.relatedTarget as HTMLElement | null;
        const movingToAnotherTech =
          related && related.closest && related.closest("[data-tech]");

        if (!movingToAnotherTech) {
          activeTech = null;
          if (currentRipple) {
            const rippleToFade = currentRipple;
            currentRipple = null;
            rippleToFade.style.transition =
              "opacity 0.9s ease-in-out, clip-path 1.1s cubic-bezier(0.4, 0, 0.2, 1)";
            rippleToFade.style.opacity = "0";
            setTimeout(() => {
              if (rippleToFade.parentNode) {
                rippleToFade.remove();
              }
            }, 1000);
          }
        }
      });
    });
  }

  setupFooterRipple();
  document.addEventListener("astro:page-load", setupFooterRipple);
</script>
